# Copy this file to .env.local in the project root (git-ignored). Never commit real keys,
# and never prefix a key with VITE_: anything VITE_ is shipped to the browser.
#
# Read by the dev server (npm run dev): the Zen key for AI answers. The browser never sees it.
ZEN_API_KEY=your-zen-key-here

# Other keys live in the speech and voice servers' own files (both git-ignored):
#   src/stt/.env.local  -> GROQ_API_KEY (speech in), optional OPENAI_API_KEY
#   src/tts/.env.local  -> PIPER_VOICE (voice out, local) or TTS_ENGINE=groq with GROQ_API_KEY
# See "Voice setup on your server" in README.md.

# Only if the speech and voice servers are not on this machine's localhost:
# VITE_STT_URL=http://localhost:8765
# VITE_TTS_URL=http://localhost:8766
